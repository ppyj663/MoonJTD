///|
fn generated_types(schema : StringView, root_name : String) -> String {
  let document = match @moonjtd.parse_checked_schema(schema) {
    Ok(value) => value
    Err(_) => abort("schema")
  }
  match @moonjtd.generate_moonbit_types(document, root_name~) {
    Ok(value) => value
    Err(_) => abort("generation")
  }
}

///|
test "identifier conversion is deterministic and safe" {
  assert_eq(@moonjtd.moon_type_name("user-profile"), "UserProfile")
  assert_eq(@moonjtd.moon_type_name("123 event"), "T123Event")
  assert_eq(@moonjtd.moon_field_name("display-name"), "displayName")
  assert_eq(@moonjtd.moon_field_name("type"), "type_")
}

///|
test "generate scalar alias" {
  let output = generated_types("{\"type\":\"uint32\"}", "UserId")
  assert_true(output.contains("typealias UserId = UInt"))
  assert_true(output.contains("Generated by MoonJTD"))
}

///|
test "generate enum declaration" {
  let output = generated_types(
    "{\"enum\":[\"pending\",\"in-progress\",\"done\"]}", "Status",
  )
  assert_true(output.contains("enum Status"))
  assert_true(output.contains("Pending"))
  assert_true(output.contains("InProgress"))
}

///|
test "generate required and optional struct fields" {
  let output = generated_types(
    "{\"properties\":{\"user-id\":{\"type\":\"uint32\"}},\"optionalProperties\":{\"display-name\":{\"type\":\"string\"}}}",
    "User",
  )
  assert_true(output.contains("struct User"))
  assert_true(output.contains("userId : UInt"))
  assert_true(output.contains("displayName : String?"))
}

///|
test "generate named definitions before root" {
  let output = generated_types(
    "{\"definitions\":{\"user-id\":{\"type\":\"uint32\"}},\"properties\":{\"id\":{\"ref\":\"user-id\"}}}",
    "User",
  )
  assert_true(output.contains("typealias UserId = UInt"))
  assert_true(output.contains("id : UserId"))
}

///|
test "generate discriminator payload structs and union" {
  let output = generated_types(
    "{\"discriminator\":\"kind\",\"mapping\":{\"circle\":{\"properties\":{\"radius\":{\"type\":\"float64\"}}},\"point\":{\"properties\":{\"x\":{\"type\":\"float64\"},\"y\":{\"type\":\"float64\"}}}}}",
    "Shape",
  )
  assert_true(output.contains("struct ShapeCircle"))
  assert_true(output.contains("struct ShapePoint"))
  assert_true(output.contains("Circle(ShapeCircle)"))
  assert_true(output.contains("Point(ShapePoint)"))
}

///|
test "generation rejects invalid root names" {
  let document = match @moonjtd.parse_checked_schema("{}") {
    Ok(value) => value
    Err(_) => abort("schema")
  }
  assert_true(
    @moonjtd.generate_moonbit_types(document, root_name="---") is Err(_),
  )
}
